# Copy to .env.local for local testing (npm run build && npm run dev:api). On Vercel, set these under Project → Settings → Environment Variables.

# Razorpay (use TEST keys first: rzp_test_...)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=          # you choose this when creating the webhook; 16+ chars

# Upstash Redis (free tier): orders, stock, rate limits. REQUIRED in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin page (/admin). 24+ random characters:  openssl rand -base64 32
ADMIN_TOKEN=

# Order emails (Resend). Optional but strongly recommended.
RESEND_API_KEY=
ORDER_FROM_EMAIL=Shonowear <orders@your-domain.com>   # a domain verified in Resend
ORDER_NOTIFY_EMAIL=you@your-domain.com                # you get an email per paid order
SITE_URL=https://your-domain.com

# Salts for hashing IPs / emails (any long random strings)
IP_HASH_SALT=
EMAIL_HASH_SALT=

# Newsletter (optional): Mailchimp or Resend audience, see api/subscribe.js

# Backups and monitoring (see README)
CRON_SECRET=
BACKUP_PASSPHRASE=
